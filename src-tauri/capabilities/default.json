{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main + pop-out + cozy-mini windows: core APIs, dialogs, window geometry (dock / pop-out / opacity), window creation, drag-out of clips. App commands need no plugin permissions. (A window label missing here gets NO permissions — not even the frame command — 2026-11-17 mini 창이 안 닫히던 원인.)",
  "windows": ["main", "pop-*", "mini"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-decorations",
    "core:window:allow-set-resizable",
    "core:window:allow-set-shadow",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-inner-position",
    "core:window:allow-inner-size",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-cursor-position",
    "core:webview:allow-create-webview-window",
    "drag:default"
  ]
}
