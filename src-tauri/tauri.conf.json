{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShowMeterBeat",
  "version": "1.0.0",
  "identifier": "com.vatvivid.re-minimeter",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ShowMeterBeat",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "theme": "Dark",
        "transparent": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "plugins/**/*",
      "models/yamnet.onnx",
      "models/yamnet_class_map.csv",
      "models/efficientat_mn10_as.onnx",
      "models/efficientat_class_map.csv",
      "models/nmp.onnx",
      "models/BASIC_PITCH_LICENSE",
      "models/kong_note.onnx",
      "models/KONG_LICENSE",
      "models/onnxruntime.dll",
      "models/onnxruntime_providers_shared.dll",
      "models/ORT_LICENSE",
      "models/ggml-base.bin"
    ],
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
